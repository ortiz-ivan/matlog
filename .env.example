# Plantilla de configuración. Copiar a .env y ajustar:
#   cp .env.example .env
# .env nunca se sube al repositorio.
# Solo las variables con prefijo VITE_ llegan al navegador: no poner secretos aquí.

# URL base del backend (repo matlog-api), sin barra final.
VITE_API_URL=http://localhost:8000

# Puerto del servidor de desarrollo. Debe estar en CORS_ORIGINS del backend.
DEV_PORT=5180
